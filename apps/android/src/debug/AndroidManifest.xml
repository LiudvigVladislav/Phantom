<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only manifest overlay. This overlay is merged into the debug
    variant's manifest ONLY; release APKs' merged manifest does NOT
    include any of the components declared here.

    The overlay hosts THREE independent debug-only entry points that
    share this file only for source-set separation from release:

      1. `phantom.android.dev.S6BreakerTriggerActivity`
         Trek 2 Stage 2B-B (C6 review-fix round 10) — S6 controllable
         breaker trigger. Historical; see legacy Trek 2 comment below.

      2. `phantom.android.dev.DebugForceMode2Activity`
         QUIESCENCE-VALIDATION-L1-SYNTHETIC-MINI-LOCK §5.2 — L1
         synthetic-trigger for Mode 2 detection. Historical; see
         legacy comment below.

      3. `phantom.android.diagnostic.DiagnosticCommandReceiver` +
         `phantom.android.diagnostic.DiagnosticBootInitProvider`
         Direct WSS Yota-First diagnostic (WSS-0..WSS-2). §11 lock 1
         + §12 P1: added additively; the release variant's merged
         manifest does NOT declare either. Verified by
         `DiagnosticSourceSetBoundaryTest.debug_manifest_grants_DUMP_permission_to_the_receiver`
         + `debug_only_diagnostic_files_do_NOT_exist_in_main_source_set`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        WSS-3 Carrier x VPN Matrix (§4.5 permission-contract): the
        DiagnosticNetworkProfileReporter (debug-only helper class)
        needs to read WifiManager.isWifiEnabled() to prove Wi-Fi is
        OFF while the phone is on cellular. That API requires
        ACCESS_WIFI_STATE, which the production manifest at
        apps/android/src/androidMain/AndroidManifest.xml does NOT
        declare. Adding it in the debug source-set overlay only:

          - release-merged manifest is unchanged (permission never
            ships to production users) — proved by
            DiagnosticProductionManifestOmitsAccessWifiStateTest
            (static source-set read);
          - debug-merged manifest carries it exactly once — proved
            by DiagnosticDebugManifestContainsAccessWifiStateTest;
          - if a future toolchain change ever silently drops it,
            the reporter catches SecurityException and emits
            wifi_enabled=null + wifi_read_error="SECURITY_EXCEPTION"
            (fail-closed, never a fabricated boolean) — proved by
            DiagnosticNetworkProfileReporterSecurityExceptionFailsClosedTest.

        See docs/tracks/direct-wss/wss-3-carrier-vpn-matrix-contract.md
        §4.5 and Round-4 change log blocker 3.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application>
        <!--
            Trek 2 Stage 2B-B (C6 review-fix round 10): the
            activity is gated on
            android.permission.INTERACT_ACROSS_USERS_FULL. The
            permission is held by the shell uid (which is what
            `adb shell am start` runs as) and is signature-scoped
            to the system signing certificate, so co-installed
            third-party apps cannot satisfy it. Verified at the
            wire on TECNO BF7-12 (round 10): `am start` from the
            shell uid 2000 launches the activity cleanly; all four
            expected logcat lines (S6 invocation, trigger fired,
            breaker open, dispatched=true) emit within ~15 ms.
            See docs/tracks/trek2-stage2b-b-tele2-smoke.md for the
            full smoke recipe and field-evidence requirements.
        -->
        <activity
            android:name="phantom.android.dev.S6BreakerTriggerActivity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!--
            QUIESCENCE-VALIDATION-L1-SYNTHETIC-MINI-LOCK §5.2 (2026-06-30)
            — manifest-side declaration of the L1 synthetic-trigger
            debug Activity. Debug-only entry point that routes
            an `adb shell am start` invocation into the L1 synthetic
            Mode 2 trigger
            [phantom.core.transport.KtorRelayTransport.debugForceMode2Synthetic].
            Identical four-layer S6BreakerTriggerActivity pattern:

              1. Declared ONLY in this debug-variant overlay; release
                 APKs do not carry the entry.
              2. Gated on `android.permission.INTERACT_ACROSS_USERS_FULL`
                 (signature-scoped to system signing cert; shell uid
                 satisfies, co-installed third-party apps cannot).
              3. `onCreate` re-checks
                 `BuildConfig.DEBUG_FORCE_MODE_2_DETECTION == "1"` AND
                 `BuildConfig.DEBUG == true` and `finish()`es if either
                 is false.
              4. `AppContainer.triggerDebugForceMode2()` re-checks the
                 BuildConfig field + the orchestrator's sticky-armed
                 state, and the `debugForceMode2Enabled` Boolean
                 injected into `KtorRelayTransport`'s constructor is
                 `false` in release as a final backstop.

            Trigger recipe (from connected laptop): use the `am start`
            command with `-n phantom.android/phantom.android.dev.DebugForceMode2Activity`
            and optionally pass the `durationMs` extra via the `am`
            long-extra flag with a value in 25000..65000 (default 45000,
            the mid-range of the Mode 2 signature window).
        -->
        <activity
            android:name="phantom.android.dev.DebugForceMode2Activity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            Direct WSS Yota-First diagnostic (WSS-0..WSS-2) —
            debug-only BroadcastReceiver. §11 lock 1 + §12 P1:
            declared ONLY in this debug source set. At release
            build time the merged manifest does NOT include this
            receiver — verified by
            `DiagnosticSourceSetBoundaryTest.debug_manifest_grants_DUMP_permission_to_the_receiver`.

            `android:exported="true"` is required so `am broadcast
            -n` from an ADB shell can invoke the receiver by
            explicit component. §12 Round-1 audit P0-6: the
            AMS-boundary enforcement replaces the earlier
            `Binder.getCallingUid()` gate — the receiver requires
            the caller to hold `android.permission.DUMP`, which
            is a signature permission granted only to the shell
            UID (2000) on stock Android. A third-party app cannot
            deliver a broadcast even if it discovers the component
            name.
        -->
        <receiver
            android:name="phantom.android.diagnostic.DiagnosticCommandReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
            Zero-touch boot-init provider: instantiated by the
            Android framework BEFORE Application.onCreate() so the
            shared WssDiagBridge is installed AND the persisted
            diagnostic state (pin + run/cell/emitter) is restored
            + emitted as a `diagnostic_session_started` WSS_DIAG
            event, before any messaging code runs. This provider
            ALSO activates `WssDiag` (release-inert-by-default
            invariant, §PR-review-round-1 P0). `exported="false"`
            — external apps cannot query.
        -->
        <provider
            android:name="phantom.android.diagnostic.DiagnosticBootInitProvider"
            android:authorities="${applicationId}.diagnostic.bootinit"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>

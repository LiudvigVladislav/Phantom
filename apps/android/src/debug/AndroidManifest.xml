<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct WSS Yota-First diagnostic — debug-only manifest overlay.

  §11 lock 1 + §12 P1: the diagnostic BroadcastReceiver is declared
  ONLY here (debug source set). At release build time the merged
  manifest does NOT include this receiver — verified by focused test
  `wss_diag_receiver_present_in_debug_manifest_and_absent_from_release_manifest`.

  `android:exported="true"` is required so `am broadcast -n` from an
  ADB shell can invoke the receiver by explicit component. §12
  Round-1 audit P0-6: the AMS-boundary enforcement replaces the
  earlier `Binder.getCallingUid()` gate — the receiver requires the
  caller to hold `android.permission.DUMP`, which is a signature
  permission granted only to the shell UID (2000) on stock Android.
  A third-party app cannot deliver a broadcast even if it discovers
  the component name.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <receiver
            android:name="phantom.android.diagnostic.DiagnosticCommandReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
          Zero-touch boot-init provider: instantiated by the Android
          framework BEFORE Application.onCreate() so the shared
          WssDiagBridge is installed AND the persisted diagnostic
          state (pin + run/cell/emitter) is restored + emitted as a
          `diagnostic_session_started` WSS_DIAG event, before any
          messaging code runs. `exported="false"` — external apps
          cannot query.
        -->
        <provider
            android:name="phantom.android.diagnostic.DiagnosticBootInitProvider"
            android:authorities="${applicationId}.diagnostic.bootinit"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct WSS Yota-First diagnostic — debug-only manifest overlay.

  §11 lock 1 (architect FINAL GREEN): the diagnostic BroadcastReceiver
  is declared ONLY here (in the debug source set). At release build
  time the merged manifest does NOT include this receiver — verified by
  focused test `wss_diag_receiver_present_in_debug_manifest_and_absent_from_release_manifest`.

  `android:exported="true"` is required so `am broadcast -n` can invoke
  the receiver by explicit component from an ADB shell. Combined with
  explicit-component invocation (no intent-filter), external apps
  cannot deliver broadcasts to this receiver — only the shell UID.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <receiver
            android:name="phantom.android.diagnostic.DiagnosticCommandReceiver"
            android:enabled="true"
            android:exported="true" />

        <!--
          Zero-touch boot-init provider: instantiated by the Android
          framework BEFORE Application.onCreate() so the shared
          WssDiagBridge is installed before any messaging code runs.
          Authority is unique + does not overlap any production
          provider. `exported="false"` — external apps cannot query.
        -->
        <provider
            android:name="phantom.android.diagnostic.DiagnosticBootInitProvider"
            android:authorities="${applicationId}.diagnostic.bootinit"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>

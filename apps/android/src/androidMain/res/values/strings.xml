    <string name="terms_title">Terms of Use</string>
    <string name="terms_subtitle">Please read before continuing</string>
    <string name="terms_welcome">Welcome to PHANTOM</string>
    <string name="terms_intro">A quick read before you start:</string>
    <string name="terms_section_1_title">1. End-to-end encrypted</string>
    <string name="terms_section_1_body">Your messages are encrypted on your device and only the recipient can decrypt them. Our servers cannot read your conversations — and we built it that way on purpose.</string>
    <string name="terms_section_2_title">2. We cannot give away what we do not have</string>
    <string name="terms_section_2_body">PHANTOM is designed so that we have no access to your messages, contacts, or activity. If anyone — including authorities — asks us for your data, we have nothing to provide.</string>
    <string name="terms_section_3_title">3. You must be 16 or older</string>
    <string name="terms_section_3_body">We require all users to be at least 16. This is for safety and legal compliance reasons.</string>
    <string name="terms_section_4_title">4. Your keys, your account</string>
    <string name="terms_section_4_body">Your identity is cryptographic keys stored only on your device. We cannot reset, recover, or transfer them. Lose your device without backup — lose your account.</string>
    <string name="terms_section_5_title">5. No phone number, no email, no real name</string>
    <string name="terms_section_5_body">Pick a username and you are in. We do not link your account to any other identifier.</string>
    <string name="terms_section_6_title">6. Use PHANTOM responsibly</string>
    <string name="terms_section_6_body">We do not endorse illegal use of the service. Reports of abuse can be sent to abuse@phntm.pro.</string>
    <string name="terms_section_7_title">7. PHANTOM is in Alpha</string>
    <string name="terms_section_7_body">Things may break. Bugs happen. Updates may change how the app works.</string>
    <string name="terms_section_8_title">8. We collect the bare minimum</string>
    <string name="terms_section_8_body">Only your public key and the IP you connect from — needed to route messages. None of it is logged or stored long-term. See the full Privacy Policy below for details.</string>
    <string name="terms_full_terms">Read full Terms</string>
    <string name="terms_privacy_policy">Privacy Policy</string>
    <string name="terms_accept_explanation">By tapping \"Accept &amp; Continue\" you confirm that you are at least 16 years old and agree to these terms and the Privacy Policy.</string>

    <string name="privacy_mode_switch_standard">Switching to Standard — direct connection should be ready in seconds.</string>
    <string name="privacy_mode_switch_private">Switching to Private — Reality probe up to 30 s, falls back to Tor (several minutes) if blocked.</string>
    <string name="privacy_mode_switch_ghost">Switching to Ghost — Tor bootstrap can take several minutes on censored networks.</string>
    <string name="privacy_mode_ghost_confirm_title">Switch to Ghost mode?</string>
    <string name="privacy_mode_ghost_confirm_body">Ghost routes every message through Tor only. If Tor cannot bootstrap on the current network the app will show \"Cannot reach relay\" instead of silently falling back to REALITY or direct WSS — that silent downgrade would defeat the privacy promise you are opting into.</string>
    <string name="privacy_mode_switch_button">Switch</string>
    <string name="privacy_mode_cancel_button">Cancel</string>
    <string name="privacy_mode_description">Choose how PHANTOM connects to the relay. Different modes trade latency for unlinkability.</string>
    <string name="privacy_mode_standard_tagline">direct WSS → REALITY → Tor</string>
    <string name="privacy_mode_standard_description">Lowest latency on clean networks; falls through to REALITY then Tor onion if direct WSS is blocked. Read receipts on. Default for new installations.</string>
    <string name="privacy_mode_private_tagline">REALITY → Tor</string>
    <string name="privacy_mode_private_description">Skip direct WSS entirely. The relay never sees your source IP. Read receipts suppressed. Connect can take up to 30 seconds for Reality, longer if it falls back to Tor.</string>
    <string name="privacy_mode_ghost_tagline">Tor onion only — no fallback</string>
    <string name="privacy_mode_ghost_description">Maximum unlinkability. If Tor cannot bootstrap on your network the app will show \"Cannot reach relay\" rather than silently downgrading to a less-private path. Read receipts suppressed. First-connect can take several minutes on censored networks while bridges bootstrap.</string>
    <string name="privacy_mode_ghost_locked_tagline">PRO · NOT AVAILABLE YET</string>
    <string name="privacy_mode_ghost_locked_description">Ghost requires a Pro subscription. Subscriptions are not available in this build.</string>
